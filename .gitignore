# Binaries
/shepherd
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of go coverage
*.out

# Dependency directories
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Editor / manual backups (e.g. client.go.bak) — never commit
*.bak

# Claude Code context (personal per-developer)
CLAUDE.md
.claude/

# Generated reports
report.html

# OS
.DS_Store
Thumbs.db

# Local config (may contain API keys)
# config.yaml is in ~/.shepherd/, not in repo

# Secrets — never commit (open-source repo)
.env
.env.*
secret.json
secrets.yaml
secrets.yml
*.tfstate
*.tfstate.backup

# Database
*.db
*.db-journal

# Plan files (development notes)
plan-step*.md
shepherd-design.md
shepherd-tasks.md

# Screenshots and test images
*.png
!assets/*.png
# Favicon, PWA icons and push badge (generated by web/scripts/gen-icons.mjs)
!web/static/*.png
*.deb

# Internal docs, prompts, and infra config (not needed for open-source)
docs/
k8s/
prompts/

# Local verification tools (not part of the shipped binary)
cmd/probe/

# Legacy build output
webui/

# Web build outputs
web/build/
web/node_modules/
web/.svelte-kit/
internal/server/web_dist/*
# Keep this placeholder tracked: internal/server/static.go does
# `//go:embed all:web_dist`, and go:embed fails to compile ("no matching files
# found") when the directory is absent or empty. Do not delete .gitkeep — a clean
# clone would no longer build. See issue #840.
!internal/server/web_dist/.gitkeep
mcp-server.log
